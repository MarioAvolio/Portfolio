# Service environment
ENVIRONMENT=local
API_PREFIX=/text-intelligence/api/v1

# LLM provider selection (mock is the default, zero-cost, no key required)
LLM_PROVIDER=mock
LLM_MODEL=mock-1
LLM_TIMEOUT_SECONDS=30

