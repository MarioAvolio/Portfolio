# insurellm service environment
ENVIRONMENT=local
API_PREFIX=/insurellm/api/v1
MODEL_NAME=gpt-4.1-nano

# Embeddings backend: "openai" (default, light) or "hf" (local, needs the `hf` extra).
INSURELLM_EMBEDDINGS=openai
# Chunking strategy: "simple" (default, free) or "llm" (richer, costs one call/doc).
INSURELLM_CHUNKING=simple
# Optional cap on indexed documents (default: all).
# INSURELLM_MAX_DOCS=20

# Required for the chat model (and for OpenAI embeddings when used).
OPENAI_API_KEY=
